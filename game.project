[project]
title = CarQuiz
version = 1.0

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[display]
width = 480
height = 854
high_dpi = 1

[html5]
scale_mode = stretch
show_made_with_defold = 0
cssfile = /builtins/manifests/web/dark_theme.css
show_console_banner = 0
show_fullscreen_button = 0
splash_image = /Assets/images/black.jpg

[graphics]
texture_profiles = /graphics/texture_profiles.texture_profiles

