local level_manager = require("scripts.managers.level_manager")
local save_manager = require("scripts.managers.save_manager")

local anim_manager = require("scripts.managers.anim_manager")


local TIMER_MAX = 10
local current_questions = {}
local current_index = 1
local lives = 3
local coins = 0
local errors = 0

function init(self)
	msg.post(".", "acquire_input_focus")

	self.paused = false
	window.set_listener(function(event, data)
		if event == window.WINDOW_EVENT_FOCUS_LOST then
			self.paused = true
		elseif event == window.WINDOW_EVENT_FOCUS_GAINED then
			self.paused = false
		end
	end)
	
	self.answered = false
	self.timer = TIMER_MAX
	self.difficulty = "easy"
	self.level_num = 1
	
	self.data = {
		{ node = "btn_answer_1", 
		color = vmath.vector4(1, 1, 1, 1),  
		hover = vmath.vector4(1, 1, 1, 1), 
		anim_color = false},

		{ node = "btn_answer_2", 
		color = vmath.vector4(1, 1, 1, 1),  
		hover = vmath.vector4(1, 1, 1, 1),  
		anim_color = false},

		{ node = "btn_answer_3", 
		color = vmath.vector4(1, 1, 1, 1),  
		hover = vmath.vector4(1, 1, 1, 1),  
		anim_color = false},

		{ node = "btn_answer_4", 
		color = vmath.vector4(1, 1, 1, 1),  
		hover = vmath.vector4(1, 1, 1, 1),  
		anim_color = false},

		{ node = "btn_hint_skip", 
		color = vmath.vector4(1, 1, 1, 1),  
		hover = vmath.vector4(1, 1, 1, 1),  
		anim_color = false},

		{ node = "btn_hint_5050", 
		color = vmath.vector4(1, 1, 1, 1),  
		hover = vmath.vector4(1, 1, 1, 1),  
		anim_color = false},
	}

	--btn_hint_5050
	--btn_hint_skip

	self.answer_buttons = {
		{ node = "btn_answer_1", text = "txt_answer_1" },
		{ node = "btn_answer_2", text = "txt_answer_2" },
		{ node = "btn_answer_3", text = "txt_answer_3" },
		{ node = "btn_answer_4", text = "txt_answer_4" },
	}
end

function on_message(self, message_id, message)
	if message_id == hash("start_game") then
		start_level(self, message.difficulty, message.level_num or 1)
	end
end

function start_level(self, difficulty, level_num)
	self.start_time = os.time()
	self.difficulty = difficulty
	self.level_num = level_num
	current_questions = level_manager.generate_level(difficulty, level_num)
	current_index = 1
	lives = 3
	coins = 0
	errors = 0
	self.level_score = 0 
	self.timer = TIMER_MAX
	self.answered = false
	
	self.hint_5050_used = false
	self.hint_skip_used = false
	load_question(self)
end

function load_question(self)
	self.answered = false
	self.timer = TIMER_MAX

	local q = current_questions[current_index]
	print("Вопрос " .. current_index .. " | Правильный: " .. q.answers[q.correct] .. " | индекс: " .. q.correct)

	self.hint_5050_used = false
	self.hint_skip_used = false

	update_coins_display(self) 

	gui.set_enabled(gui.get_node("btn_hint_5050"), true)
	gui.set_enabled(gui.get_node("btn_hint_skip"), true)

	gui.set_text(gui.get_node("txt_question"), current_index .. "/15")
	update_lives(self)

	gui.play_flipbook(gui.get_node("car_image"), hash(q.img))

	for i, btn in ipairs(self.answer_buttons) do
		local node = gui.get_node(btn.node)
		local text = gui.get_node(btn.text)
		gui.set_text(text, q.answers[i])
		gui.set_color(node, vmath.vector4(1,1,1, 1))
		gui.set_enabled(node, true)
	end

	gui.set_size(gui.get_node("timer_bar"), vmath.vector3(260, 20, 0))
	gui.set_color(gui.get_node("timer_bar"), vmath.vector4(0, 1, 0, 1))
end

function update_lives(self)
	for i = 1, 3 do
		local node = gui.get_node("symbol_heart" .. i)
		if i <= lives then
			gui.play_flipbook(node, hash("heart4"))
		else
			gui.play_flipbook(node, hash("empty_heart4"))
		end
	end
end

function update(self, dt)
	if self.answered then return end
	if #current_questions == 0 then return end  
	if self.paused then return end

	self.timer = self.timer - dt
	local pct = math.max(0, self.timer / TIMER_MAX)
	gui.set_size(gui.get_node("timer_bar"), vmath.vector3(260 * pct, 20, 0))

	if self.timer < 5 then
		gui.set_color(gui.get_node("timer_bar"), vmath.vector4(0.85, 0.2, 0.2, 1))
	end

	if self.timer <= 0 then
		time_out(self)
	end
end

function select_answer(self, index)
	if self.answered then return end
	self.answered = true

	local q = current_questions[current_index]
	local is_correct = index == q.correct
	local is_fast = self.timer > 5

	if is_correct then
		local earned_coins = is_fast and 2 or 1
		local earned_score = is_fast and 30 or 10
		coins = coins + earned_coins
		self.level_score = self.level_score + earned_score
		gui.set_color(gui.get_node(self.answer_buttons[index].node), vmath.vector4(0.11, 0.62, 0.46, 1))
		update_coins_display(self) 
	else
		errors = errors + 1
		lives = lives - 1
		gui.set_color(gui.get_node(self.answer_buttons[index].node), vmath.vector4(0.85, 0.2, 0.2, 1))
		gui.set_color(gui.get_node(self.answer_buttons[q.correct].node), vmath.vector4(0.11, 0.62, 0.46, 1))
		update_lives(self)
	end

	timer.delay(1.2, false, function()
		next_question(self)
	end)
end

function time_out(self)
	if self.answered then return end
	self.answered = true
	errors = errors + 1
	lives = lives - 1
	update_lives(self)

	local q = current_questions[current_index]
	gui.set_color(gui.get_node(self.answer_buttons[q.correct].node), vmath.vector4(0.11, 0.62, 0.46, 1))
	
	timer.delay(1.2, false, function()
		next_question(self)
	end)
end

function next_question(self)
	if lives <= 0 then
		end_level(self, false)
		return
	end

	current_index = current_index + 1

	if current_index > 15 then
		end_level(self, true)
	else
		load_question(self)
	end
end

function end_level(self, win)
	local elapsed = os.time() - self.start_time  
	local minutes = math.floor(elapsed / 60)
	local seconds = elapsed % 60
	local time_str = string.format("%d:%02d", minutes, seconds)
	
	local stars = 0

	if win then
		if errors == 0 then stars = 3
		elseif errors == 1 then stars = 2
		elseif errors == 2 then stars = 1
		end
		save_manager.set_stars(self.difficulty, self.level_num, stars)
	end

	save_manager.add_coins(coins)
	save_manager.add_score(self.level_score or 0)
	
	msg.post("/menu#menu", "enable")
	msg.post("/gameplay#gameplay", "disable")
	msg.post("/menu#menu", "show_result", {
		win = win,
		stars = stars,
		coins = coins,
		errors = errors,
		time = time_str,
		difficulty = self.difficulty,
		level_num = self.level_num
	})
end

local function apply_hover_out(node, btn)
	local size = btn.defaultsize or vmath.vector3(1, 1, 1)
	if get_category_unlocked(btn.difficulty) or btn.difficulty == nil then
		anim_manager.hover_out(node, btn.color, size, btn.anim_color, btn.anim_scale)
	else
		gui.animate(node, gui.PROP_SCALE, size, gui.EASING_OUT, 0.1, 0)
	end
end

local function apply_hover_in(node, btn)
	local size = btn.hoversize or vmath.vector3(1.03, 1.03, 1)
	if get_category_unlocked(btn.difficulty) or btn.difficulty == nil then
		anim_manager.hover_in(node, btn.hover, size, btn.anim_color, btn.anim_scale)
	else
		gui.animate(node, gui.PROP_SCALE, size, gui.EASING_OUT, 0.1, 0)
	end
end

local function process_hover(action_id, action, self)
	if action_id ~= nil then return end

	for _, btn in pairs(self.data) do
		if btn.hover == nil or btn.color == nil then return end

		local node = gui.get_node(btn.node)

		if not gui.is_enabled(node, true) then
			btn.hovered = false
			apply_hover_out(node, btn)
		elseif gui.pick_node(node, action.x, action.y) then
			if not btn.hovered then
				btn.hovered = true
				apply_hover_in(node, btn)

				play_sound_effect(self, "hover")
			end
		elseif btn.hovered then
			btn.hovered = false
			apply_hover_out(node, btn)
		end
	end
end

function on_input(self, action_id, action)
	if not gui.is_enabled(gui.get_node("top_bar"), true) then return end

	if action_id == hash("touch") and action.pressed then
		local btn_5050 = gui.get_node("btn_hint_5050")
		if gui.is_enabled(btn_5050, true) and gui.pick_node(btn_5050, action.x, action.y) then
			use_hint_5050(self)
			return
		end
		
		local btn_skip = gui.get_node("btn_hint_skip")
		if gui.is_enabled(btn_skip, true) and gui.pick_node(btn_skip, action.x, action.y) then
			use_hint_skip(self)
			return
		end
		
		for i, btn in ipairs(self.answer_buttons) do
			local node = gui.get_node(btn.node)
			if gui.pick_node(node, action.x, action.y) then
				select_answer(self, i)
				break
			end
		end
	end

	process_hover(action_id, action, self)
end

function use_hint_5050(self)
	if self.hint_5050_used or self.answered then return end
	local save_data = save_manager.load()
	if save_data.coins < 10 then
		print("Недостаточно монет! Нужно 10")
		return
	end
	self.hint_5050_used = true
	save_manager.add_coins(-10)
	--gui.set_enabled(gui.get_node("btn_hint_5050"), false)

	local q = current_questions[current_index]
	local wrong_buttons = {}
	for i, btn in ipairs(self.answer_buttons) do
		if i ~= q.correct then
			table.insert(wrong_buttons, i)
		end
	end

	for i = #wrong_buttons, 2, -1 do
		local j = math.random(i)
		wrong_buttons[i], wrong_buttons[j] = wrong_buttons[j], wrong_buttons[i]
	end

	for i = 1, 2 do
		local node = gui.get_node(self.answer_buttons[wrong_buttons[i]].node)
		gui.set_enabled(node, false)
	end

	update_coins_display(self)
end

function update_coins_display(self)
	local save_data = save_manager.load()
	local total = save_data.coins + coins
	gui.set_text(gui.get_node("txt_coins"), "$ " .. total .. " (+" .. coins .. ")")
end

function use_hint_skip(self)
	if self.hint_skip_used or self.answered then return end
	local save_data = save_manager.load()
	if save_data.coins < 20 then
		print("Недостаточно монет! Нужно 20")
		return
	end
	self.hint_skip_used = true
	self.answered = true
	save_manager.add_coins(-20)
	--gui.set_enabled(gui.get_node("btn_hint_skip"), false)

	update_coins_display(self)

	timer.delay(0.3, false, function()
		next_question(self)
	end)
end
