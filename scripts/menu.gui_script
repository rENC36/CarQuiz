-- scripts/menu/menu.gui_script
local menu_manager = require("scripts.managers.menu_manager")

function init(self)
	msg.post(".", "acquire_input_focus")
	menu_manager.init(self)
end

function on_message(self, message_id, message, sender)
	menu_manager.on_message(self, message_id, message)
end

function on_input(self, action_id, action)
	menu_manager.on_input(self, action_id, action)
end