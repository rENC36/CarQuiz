local save_manager = require("scripts.managers.save_manager")
local anim_manager = require("scripts.managers.anim_manager")

local buttons_data = require("scripts.data.buttons_data")

function init(self)
	msg.post(".", "acquire_input_focus")

	msg.post(".", "acquire_input_focus")
	local save_data = save_manager.load()
	print("Монет в сохранении: " .. save_data.coins)
	gui.set_text(gui.get_node("txt_total_coins"), "$ " .. save_data.coins)
	
	self.sound_on = true
	self.buttons = buttons_data
	
	change_gui("menu", self)
	print("Menu init работает!")

	local total_stars = 0
	local total_levels = 0
	local difficulties = {"easy", "medium", "hard"}

	for _, diff in ipairs(difficulties) do
		for lvl = 1, 3 do
			local stars = save_manager.get_stars(diff, lvl)
			total_stars = total_stars + stars
			if stars > 0 then
				total_levels = total_levels + 1
			end
		end
	end

	gui.set_text(gui.get_node("StarsOutput"), total_stars .. "/27")
	gui.set_text(gui.get_node("LevelsOutput"), total_levels .. "/9")
end

function show_levels(self, difficulty)
	gui.set_text(gui.get_node("txt_levels_title"),
	difficulty == "easy" and "Лёгкий" or
	difficulty == "medium" and "Средний" or "Тяжёлый")

	for i = 1, 3 do
		local stars = save_manager.get_stars(difficulty, i)
		local locked = i > 1 and save_manager.get_stars(difficulty, i-1) == 0

		print("Уровень " .. i .. " звёзд: " .. stars)

		gui.set_color(gui.get_node("star" .. i .. "_1"), vmath.vector4(0,0,0, .5))
		gui.set_color(gui.get_node("star" .. i .. "_2"), vmath.vector4(0,0,0, .5))
		gui.set_color(gui.get_node("star" .. i .. "_3"), vmath.vector4(0,0,0, .5))
		
		for s = 1, stars do
			local but = gui.get_node("star" .. i .. "_" .. s)
			gui.set_color(but, vmath.vector4(1, 1, 1, 1))
		end
		
		if locked then
			gui.set_color(gui.get_node("btn_level_" .. i), vmath.vector4(0.2, 0.2, 0.2, .5))
			change_level_color(vmath.vector4(0.2, 0.2, 0.2, .5), i, self)
		else
			if stars == 3 then
				gui.set_color(gui.get_node("btn_level_" .. i), vmath.vector4(1, 1, 0, 1))
				change_level_color(vmath.vector4(1, 1, 0, 1), i, self)
			else
				gui.set_color(gui.get_node("btn_level_" .. i), vmath.vector4(1, 1, 1, 1))
				change_level_color(vmath.vector4(1, 1, 1, 1), i, self)
			end
		end
	end
end

function change_level_color(color, i, self)
	for _, screen_name in ipairs(self.buttons) do
		if screen_name.node == "btn_level_" .. i then
			screen_name.color = color
		end
	end
end

function toggle_sound(bool, self)
	if bool and self.sound_on == false then
		msg.post("/music#sound", "play_sound")
	elseif not bool and self.sound_on == true  then
		msg.post("/music#sound", "stop_sound")
	end
end

function update_category_progress(self)
	local bar_states = {
		[0] = { alpha = 0,    scale_x = 1,    pos_x = 0 },
		[1] = { alpha = 1,    scale_x = 0.4,  pos_x = -182 },
		[2] = { alpha = 1,    scale_x = 0.8,  pos_x = -151 },
		[3] = { alpha = 1,    scale_x = 1.33, pos_x = -112 },
	}

	local difficulties = {"easy", "medium", "hard"}
	local nodes = {"Easy", "Medium", "Hard"}

	for i, diff in ipairs(difficulties) do
		local completed = 0
		for lvl = 1, 3 do
			if save_manager.get_stars(diff, lvl) > 0 then
				completed = completed + 1
			end
		end

		local pct = math.floor((completed / 3) * 100)
		gui.set_text(gui.get_node(nodes[i] .. "Completed"), completed .. "/3 (" .. pct .. "%)")

		if completed == 3 then
			gui.set_color(gui.get_node(nodes[i] .. "Completed"), vmath.vector4(1,1,0,1))
		end

		local state = bar_states[completed]
		local bar = gui.get_node("progress_bar_line_" .. diff)

		local color = gui.get_color(bar)
		color.w = state.alpha
		gui.set_color(bar, color)

		local scale = gui.get_scale(bar)
		scale.x = state.scale_x
		gui.set_scale(bar, scale)

		local pos = gui.get_position(bar)
		pos.x = state.pos_x
		gui.set_position(bar, pos)
	end
end

function change_gui(name, self)
	local screens = {"menu", "settings", "categories", "leaderboard", "result", "levels"}
	local difficultys = {"easy", "medium", "hard"}

	for _, screen_name in ipairs(screens) do
		if screen_name == "categories" then
			for _, diff in ipairs(difficultys) do
				if not get_category_unlocked(diff) then
					gui.set_color(gui.get_node("btn_" .. diff), vmath.vector4(0,0,0, .5))
				end
			end
			if self then update_category_progress(self) end
		end

		local node = gui.get_node("screen_" .. screen_name)
		gui.set_enabled(node, screen_name == name)
	end
end

function on_message(self, message_id, message)
	if message_id == hash("show_result") then
		
		local save_data = save_manager.load()
		gui.set_text(gui.get_node("txt_total_coins"), "$ " .. save_data.coins)
		
		gui.set_text(gui.get_node("txt_result_title"), message.win and "УРОВЕНЬ ПРОЙДЕН!" or "ПРОИГРЫШ")
		gui.set_text(gui.get_node("txt_result_coins"), "Монет: +" .. message.coins)
		gui.set_text(gui.get_node("txt_result_errors"), "Ошибок: " .. message.errors)
		gui.set_text(gui.get_node("txt_result_time"), "Время: " .. message.time)
		
		for i = 1, 3 do
			gui.set_color(gui.get_node("star" .. i .. "_result"), i <= message.stars and vmath.vector4(1,1,1, .5) or vmath.vector4(0,0,0, .5))
		end
		
		local stars_text = ""
		for i = 1, 3 do
			stars_text = stars_text .. (i <= message.stars and "* " or "- ")
		end

		self.last_difficulty = message.difficulty or "easy"
		self.last_level = message.level_num or 1
		self.last_win = message.win
		
		gui.set_text(gui.get_node("txt_result_stars"), stars_text)
		gui.set_text(gui.get_node("txt_result_next"), message.win and "СЛЕДУЮЩИЙ УРОВЕНЬ" or "ПРОЙТИ ЕЩЕ РАЗ")

		change_gui("result", self)
	end
end

function settings_music_control(self, screen_settings, action)
	if gui.is_enabled(screen_settings, true) 
	and gui.pick_node(gui.get_node("OnBox"), action.x, action.y) then
		local onText = gui.get_node("OnText")
		local offText = gui.get_node("OffText")

		gui.set_color(onText, vmath.vector4(0,0,0,1))
		gui.set_color(offText, vmath.vector4(1,1,1,1))
		toggle_sound(true, self)
		self.sound_on = true
		return
	elseif gui.is_enabled(screen_settings, true) 
	and gui.pick_node(gui.get_node("OffBox"), action.x, action.y)  then
		local onText = gui.get_node("OnText")
		local offText = gui.get_node("OffText")

		gui.set_color(onText, vmath.vector4(1,1,1,1))
		gui.set_color(offText, vmath.vector4(0,0,0,1))
		toggle_sound(false, self)
		self.sound_on = false
		return
	end
end

local function apply_hover_out(node, btn)
	local size = btn.defaultsize or vmath.vector3(1, 1, 1)
	if not get_category_unlocked(btn.difficulty) then
		gui.animate(node, gui.PROP_SCALE, size, gui.EASING_OUT, 0.1, 0)
	else
		anim_manager.hover_out(node, btn.color, size, btn.anim_color, btn.anim_scale)
	end
end

local function apply_hover_in(node, btn)
	local size = btn.hoversize or vmath.vector3(1.03, 1.03, 1)
	if not get_category_unlocked(btn.difficulty) then
		gui.animate(node, gui.PROP_SCALE, size, gui.EASING_OUT, 0.1, 0)
	else
		anim_manager.hover_in(node, btn.hover, size, btn.anim_color, btn.anim_scale)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.released then
		local screen_settings = gui.get_node("screen_settings")
		settings_music_control(self, screen_settings, action)
		
		for _, btn in ipairs(self.buttons) do
			local node = gui.get_node(btn.node)
			if gui.is_enabled(node, true) and gui.pick_node(node, action.x, action.y) then
				print(btn.node .. " нажато")
				msg.post("/music#sound_click", "play_sound")
				
				if not btn.target then
					break
				end
				
				if btn.target == "levels" then
					if not get_category_unlocked(btn.difficulty) then
						return
					end
					self.selected_difficulty = btn.difficulty
					show_levels(self, btn.difficulty)
					change_gui("levels", self)

				elseif btn.node == "btn_result_next" then
					local next_level = self.last_win and (self.last_level + 1) or self.last_level
					if next_level > 3 then next_level = 3 end
					msg.post("/gameplay#gameplay", "enable")
					msg.post("/menu#menu", "disable")
					timer.delay(0.1, false, function()
						msg.post("/gameplay#gameplay", "start_game", {
							difficulty = self.last_difficulty,
							level_num = next_level
						})
					end)

				elseif btn.target == "gameplay" and btn.level_num then
					local locked = btn.level_num > 1 and save_manager.get_stars(self.selected_difficulty, btn.level_num - 1) == 0
					if locked then
						print("Уровень заблокирован!")
					else
						msg.post("/gameplay#gameplay", "enable")
						msg.post("/menu#menu", "disable")
						timer.delay(0.1, false, function()
							msg.post("/gameplay#gameplay", "start_game", {
								difficulty = self.selected_difficulty,
								level_num = btn.level_num
							})
						end)
					end

				else
					change_gui(btn.target, self)
				end
				break
			end
		end
	end

	if action_id == nil then
		for _, btn in pairs(self.buttons) do
			if btn.hover ~= nil and btn.color ~= nil then
				local node = gui.get_node(btn.node)
				if not gui.is_enabled(node, true) then
					btn.hovered = false
				else
					local is_hover = gui.pick_node(node, action.x, action.y)
					if is_hover and not btn.hovered then
						btn.hovered = true
						apply_hover_in(node, btn)
						msg.post("/music#sound_hover", "play_sound")
					elseif not is_hover and btn.hovered then
						btn.hovered = false
						apply_hover_out(node, btn)
					end
				end
			end
		end
	end
end

function get_category_unlocked(difficulty)
	if difficulty == "easy" then return true end

	local prev = difficulty == "medium" and "easy" or "medium"
	for lvl = 1, 3 do
		if save_manager.get_stars(prev, lvl) == 0 then
			return false
		end
	end
	return true
end